        "message": "=Hi {{ $json.full_name }},\n\nIt's time for your {{ $json.cycle }} self-review. It takes about 10 minutes:\n\n{{ $json.self_review_url }}\n\nPlease submit by {{ $json.due_date }}. Be specific: concrete results, what you learned, and what support you need.\n\nThank you!",
        "options": {}
