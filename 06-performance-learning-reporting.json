    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst today = new Date(); today.setHours(0, 0, 0, 0);\nconst out = [];\nfor (const t of items) {\n  if (['completed', 'waived'].includes(t.status)) continue;\n  const due = new Date(t.due_date + 'T00:00:00');\n  const diff = Math.round((due - today) / 86400000);\n  if (diff < 0) out.push({ json: { ...t, state: 'overdue', days_overdue: -diff, escalate: -diff >= 7 } });\n  else if (diff <= 7) out.push({ json: { ...t, state: 'due_soon', days_to_due: diff, escalate: false } });\n}\nreturn out;"
      },
      "id": "find-overdue-and-due-soon",
      "name": "Find Overdue & Due Soon",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        1750
      ]
    },
    {
