      "id": "get-review-and-training-status",
      "name": "Get Review & Training Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        2300
      ],
      "notes": "Expected: reviews_completed, reviews_total, training_completed, training_total, overdue_training.",
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const h = $('Get Headcount & Movement').first().json;\nconst a = $('Get Attendance Summary').first().json;\nconst r = $('Get Review & Training Status').first().json;\nconst pct = (n, d) => d > 0 ? Math.round(n / d * 1000) / 10 : null;\nconst avgHc = h.headcount_start != null ? (h.headcount_start + h.headcount) / 2 : h.headcount;\n\nconst kpis = {\n  headcount: h.headcount, joiners_30d: h.joiners_30d, leavers_30d: h.leavers_30d,\n  open_positions: h.open_positions,\n  turnover_30d_pct: pct(h.leavers_30d, avgHc),\n  absence_rate_pct: a.absence_rate_pct, overtime_hours: a.overtime_hours, late_incidents: a.late_incidents,\n  review_completion_pct: pct(r.reviews_completed, r.reviews_total),\n  training_compliance_pct: pct(r.training_completed, r.training_total),\n  overdue_training: r.overdue_training\n};\n\n// Thresholds: adjust to your targets\nconst alerts = [];\nif (kpis.turnover_30d_pct != null && kpis.turnover_30d_pct > 3) alerts.push(`30-day turnover ${kpis.turnover_30d_pct}% is above 3%`);\nif (kpis.absence_rate_pct != null && kpis.absence_rate_pct > 5) alerts.push(`Absence rate ${kpis.absence_rate_pct}% is above 5%`);\nif (kpis.training_compliance_pct != null && kpis.training_compliance_pct < 90) alerts.push(`Training compliance ${kpis.training_compliance_pct}% is below 90%`);\nif (kpis.review_completion_pct != null && kpis.review_completion_pct < 80) alerts.push(`Review completion ${kpis.review_completion_pct}% is below 80%`);\n\nreturn [{ json: { generated_at: new Date().toISOString(), kpis, alerts } }];"
      },
