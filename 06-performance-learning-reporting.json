      "name": "Get Active Employees",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "notes": "Expected fields: employee_id, full_name, email, manager_email, status. If the API wraps the array in an object, add a Split Out node."
    },
    {
      "parameters": {
        "jsCode": "const emps = $input.all().map(i => i.json);\nconst now = new Date();\nlet q = Math.floor(now.getMonth() / 3), year = now.getFullYear();\nif (q === 0) { q = 4; year -= 1; }                 // review the quarter that just ended\nconst cycle = `${year}-Q${q}`;\nconst due = new Date(now); due.setDate(due.getDate() + 14);\nconst dueStr = `${due.getFullYear()}-${String(due.getMonth() + 1).padStart(2, '0')}-${String(due.getDate()).padStart(2, '0')}`;\nreturn emps.filter(e => e.status !== 'inactive').map(e => ({ json: {\n  employee_id: e.employee_id, full_name: e.full_name, email: e.email, manager_email: e.manager_email,\n  cycle, due_date: dueStr,\n  self_review_url: `https://YOUR-N8N-URL/form/self-review?employee_id=${encodeURIComponent(e.employee_id)}&cycle=${cycle}`\n} }));"
      },
      "id": "build-review-requests",
      "name": "Build Review Requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
