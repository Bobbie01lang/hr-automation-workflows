            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Payload": {
      "main": [
        [
          {
            "node": "AI Extract Candidate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Extract Candidate": {
      "main": [
        [
          {
            "node": "Validation Gate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validation Gate": {
      "main": [
        [
          {
            "node": "Create Employee in HRIS",
            "type": "main",
