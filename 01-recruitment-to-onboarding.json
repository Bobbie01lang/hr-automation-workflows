            "index": 0
          }
        ]
      ]
    },
    "Email Writer Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Draft Welcome Email",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Error Trigger": {
