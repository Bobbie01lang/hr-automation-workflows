            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait Until 2 Days Before Start": {
      "main": [
        [
          {
            "node": "Trigger Account Provisioning",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extractor Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Extract Candidate",
