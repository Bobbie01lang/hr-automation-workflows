{
  "name": "Offboarding (Resignation to Clearance)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hris-offboarding",
        "authentication": "headerAuth",
        "options": {}
      },
      "id": "offboarding-webhook",
      "name": "Offboarding Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "notes": "Call from HRIS when a resignation is accepted or a termination is approved. Body: { employee_id, separation_type: resignation|termination|end_of_contract|retirement, last_working_day: YYYY-MM-DD, immediate_access_revoke?: boolean }.",
      "webhookId": "f21e5d38-9c3c-4a02-8c88-8d90174764e6"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://YOUR-HRIS.example.com/api/employees/{{ $json.body.employee_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_TOKEN"
            }
          ]
        },
        "options": {}
      },
      "id": "get-employee-details",
      "name": "Get Employee Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ],
      "notes": "Expected fields: employee_id, full_name, email, department, job_title, manager_email, leave_balance."
    },
    {
      "parameters": {
        "jsCode": "const b = $('Offboarding Webhook').first().json.body;\nconst emp = $('Get Employee Details').first().json;\n\nconst [Y, M, D] = b.last_working_day.split('-').map(Number);\nconst lwd = new Date(Y, M - 1, D);\nconst addDays = (d, n) => { const x = new Date(d); x.setDate(x.getDate() + n); return x; };\nconst fmt = d => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;\n\nconst type = b.separation_type;\nconst involuntary = type === 'termination';\nconst immediate = b.immediate_access_revoke ?? involuntary;\nconst revokeAt = new Date(Y, M - 1, D, 18, 0, 0);          // 6:00 PM on last working day\nconst FINAL_PAY_DAYS = 30;                                  // default; confirm with company policy / counsel\n\nconst tasks = {\n  HR: [\n    'Confirm resignation/termination documents are complete',\n    involuntary ? 'Confirm termination process and documentation reviewed by HR/legal' : 'Schedule exit interview',\n    'Prepare clearance form',\n    'Compute final pay (unused leave, pro-rated benefits, deductions, tax)',\n    'Prepare Certificate of Employment (on request)'\n  ],\n  IT: [\n    `Disable accounts ${immediate ? 'immediately' : 'at 6:00 PM on ' + b.last_working_day}`,\n    'Collect laptop, phone and other devices',\n    'Transfer mailbox, files and shared drive ownership to manager',\n    'Remove licences and group memberships'\n  ],\n  Manager: [\n    'Complete handover plan and knowledge transfer',\n    'Reassign open tasks, clients and projects',\n    'Transfer shared documents and credentials ownership',\n    'Announce departure to the team (with HR approval of wording)'\n  ],\n  Finance: [\n    'Settle cash advances, loans and pending reimbursements',\n    'Cancel company card / expense access'\n  ],\n  Facilities: [\n    'Collect ID, badge and keys',\n    'Remove building and parking access'\n  ]\n};\nconst checklist_text = Object.entries(tasks).map(([team, items]) => `*${team}*\\n` + items.map(t => '\u2022 ' + t).join('\\n')).join('\\n\\n');\n\nreturn [{ json: {\n  employee_id: emp.employee_id, full_name: emp.full_name, email: emp.email,\n  department: emp.department, job_title: emp.job_title, manager_email: emp.manager_email,\n  leave_balance: emp.leave_balance ?? null,\n  separation_type: type, last_working_day: b.last_working_day,\n  immediate_revoke: immediate, send_exit_interview: !involuntary,\n  revoke_at: revokeAt.toISOString(),\n  exit_interview_by: fmt(addDays(lwd, -2)),\n  final_pay_due: fmt(addDays(lwd, FINAL_PAY_DAYS)),\n  tasks, checklist_text\n} }];"
      },
      "id": "build-offboarding-plan",
      "name": "Build Offboarding Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "notes": "Edit the task lists, the 6:00 PM revoke time and FINAL_PAY_DAYS to match your policy and local labor rules."
    },
