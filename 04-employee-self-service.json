{
  "name": "Employee Self-Service & HR Requests (AI Router)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hr-request",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "request-webhook",
      "name": "Request Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "notes": "Body: { \"email\": \"juan@company.com\", \"message\": \"I want to file leave Dec 22-26\" }. Connect from a Slack slash command / Teams bot / web form. Slack slash commands send form-encoded data, so map user email and text into this JSON shape first."
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "Thanks! Your request was received. You will get an email update shortly.",
        "options": {}
      },
      "id": "acknowledge-request",
      "name": "Acknowledge Request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://YOUR-HRIS.example.com/api/employees",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "email",
              "value": "={{ $('Request Webhook').first().json.body.email }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_TOKEN"
            }
          ]
        },
        "options": {}
      },
      "id": "lookup-employee",
      "name": "Lookup Employee",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "notes": "Identity comes from the verified sender email, never from the message text. Expected fields: employee_id, full_name, email, department, manager_email, leave_balance (number or object by leave type).",
      "executeOnce": true
    },
    {
      "parameters": {
        "text": "={{ $('Request Webhook').first().json.body.message }}",
        "attributes": {
          "attributes": [
            {
              "name": "category",
              "type": "string",
              "description": "One of: leave_request, hr_question, certificate_request, payslip_request, profile_update, expense_reimbursement, it_equipment, other",
              "required": true
            },
            {
              "name": "leave_type",
              "type": "string",
              "description": "vacation, sick, emergency, or other. Empty if not a leave request",
              "required": false
            },
            {
              "name": "start_date",
              "type": "string",
              "description": "Leave start date YYYY-MM-DD, assume the current year if missing",
              "required": false
            },
            {
              "name": "end_date",
              "type": "string",
              "description": "Leave end date YYYY-MM-DD",
              "required": false
            },
            {
              "name": "details",
              "type": "string",
              "description": "One-sentence summary of what the employee wants",
              "required": true
            },
            {
              "name": "sensitive",
              "type": "boolean",
              "description": "True if the message involves harassment, discrimination, grievance, resignation, medical or legal matters, or safety",
              "required": true
            },
            {
              "name": "confidence",
              "type": "number",
              "description": "0 to 1 confidence in the category and extracted fields",
              "required": true
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "You classify employee self-service messages for an HR team. Never invent dates or values. Today's date is {{ $now.toISODate() }}. If the intent is unclear, use category 'other' and a low confidence."
        }
      },
      "id": "ai-classify-request",
      "name": "AI Classify Request",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.1,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "id": "classifier-model",
      "name": "Classifier Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        720,
        520
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.output.confidence }}",
              "rightValue": 0.75,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "leftValue": "={{ $json.output.sensitive }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "safe-to-automate",
      "name": "Safe to Automate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        300
      ],
      "notes": "Sensitive or low-confidence requests always go to a human."
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.output.category }}",
                    "rightValue": "leave_request",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Leave"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.output.category }}",
                    "rightValue": "hr_question",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "HR Question"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Service Request"
        }
      },
      "id": "route-request",
      "name": "Route Request",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const c = $('AI Classify Request').first().json.output;\nconst emp = $('Lookup Employee').first().json;\nconst s = new Date(c.start_date), e = new Date(c.end_date || c.start_date);\nconst valid = !isNaN(s) && !isNaN(e) && e >= s;\nlet days = 0;\nif (valid) {\n  for (let d = new Date(s); d <= e; d.setDate(d.getDate() + 1)) {\n    const w = d.getDay();\n    if (w !== 0 && w !== 6) days++;   // skip weekends; subtract company holidays if needed\n  }\n}\nconst lb = emp.leave_balance;\nconst balance = typeof lb === 'object' && lb !== null ? Number(lb[c.leave_type] ?? 0) : Number(lb ?? 0);\nreturn [{ json: { working_days: days, balance, ok: valid && days > 0 && days <= balance } }];"
      },
      "id": "validate-leave-request",
      "name": "Validate Leave Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "balance-ok",
      "name": "Balance OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1680,
        0
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendAndWait",
        "sendTo": "={{ $('Lookup Employee').first().json.manager_email }}",
        "subject": "=Leave approval needed: {{ $('Lookup Employee').first().json.full_name }}",
        "message": "={{ $('Lookup Employee').first().json.full_name }} requests {{ $('AI Classify Request').first().json.output.leave_type }} leave from {{ $('AI Classify Request').first().json.output.start_date }} to {{ $('AI Classify Request').first().json.output.end_date }} ({{ $('Validate Leave Request').first().json.working_days }} working days, balance {{ $('Validate Leave Request').first().json.balance }}).\n\nNotes: {{ $('AI Classify Request').first().json.output.details }}",
        "responseType": "approval",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Approve",
            "disapproveLabel": "Reject"
          }
        },
        "options": {}
      },
      "id": "manager-approval",
      "name": "Manager Approval",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1920,
        -100
      ],
      "notes": "Pauses until the manager clicks Approve or Reject in the email. Verify parameter names in your n8n version; Slack and Teams nodes also support Send and Wait."
