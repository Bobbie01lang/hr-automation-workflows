    {
      "parameters": {
        "jsCode": "const c = $('AI Classify Request').first().json.output;\nconst map = {\n  certificate_request:   { team: 'HR Ops',  sla: '3 business days', channel: '#hr-requests' },\n  payslip_request:       { team: 'Payroll', sla: '2 business days', channel: '#hr-payroll' },\n  profile_update:        { team: 'HR Ops',  sla: '3 business days', channel: '#hr-requests' },\n  expense_reimbursement: { team: 'Finance', sla: '5 business days', channel: '#finance-requests' },\n  it_equipment:          { team: 'IT',      sla: '2 business days', channel: '#it-helpdesk' }\n};\nconst r = map[c.category] ?? { team: 'HR Ops', sla: '3 business days', channel: '#hr-requests' };\nreturn [{ json: { ticket_id: 'REQ-' + Date.now().toString(36).toUpperCase(), ...r } }];"
      },
